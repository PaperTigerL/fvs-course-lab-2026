+    if (spmat_filter_ == nullptr || filter_data == nullptr) return 0;
+    uint32_t q_count = 0;
+    memcpy(&q_count, filter_data, sizeof(uint32_t));
+    if (q_count != 1) return 0;  // workload queries carry one label; fall back otherwise
+    uint32_t label = 0;
+    memcpy(&label, (const char *) filter_data + sizeof(uint32_t), sizeof(uint32_t));
+    const auto &nodes = spmat_filter_->nodes_for_label(label);
+    if (nodes.empty()) return 0;
+
+    auto proc_st = std::chrono::high_resolution_clock::now();
+    QueryBuffer<T> *query_buf = pop_query_buf(query1);
+    const T *query = query_buf->aligned_query_T;
+    nbr_handler->initialize_query(query, query_buf);
+    float *dist_scratch = query_buf->aligned_dist_scratch;
+
+    // PQ-rank all label candidates in chunks (dist_scratch holds MAX_N_EDGES).
+    std::vector<std::pair<float, uint32_t>> cand;
+    cand.reserve(nodes.size());
+    const size_t chunk = std::min<size_t>(MAX_N_EDGES, 1024);
+    for (size_t start = 0; start < nodes.size(); start += chunk) {
+      size_t cnt = std::min(chunk, nodes.size() - start);
+      nbr_handler->compute_dists(query_buf, nodes.data() + start, cnt);
+      for (size_t i = 0; i < cnt; i++) {
+        cand.emplace_back(dist_scratch[i], nodes[start + i]);
+      }
+    }
+    if (stats != nullptr) stats->n_cmps += (double) nodes.size();
+
+    // Read only the top P by PQ.  P is tunable; default 128.
+    uint32_t p = 128;
+    if (const char *env = std::getenv("GATEANN_PREFILTER_P")) {
+      int v = std::atoi(env);
+      if (v > 0) p = (uint32_t) v;
+    }
+    size_t keep = std::min<size_t>(cand.size(), std::max<size_t>(p, 1));
+    if (keep < cand.size()) {
+      std::nth_element(cand.begin(), cand.begin() + keep, cand.end());
+      cand.resize(keep);
+    }
+
+    // Read top-P nodes synchronously in small batches; exact rerank.
+    void *ctx = reader->get_ctx();
+    const size_t batch = 32;
+    std::vector<std::pair<float, uint32_t>> exact;
+    exact.reserve(cand.size());
+    for (size_t start = 0; start < cand.size(); start += batch) {
+      size_t cnt = std::min(batch, cand.size() - start);
+      std::vector<IORequest> reqs;
+      std::vector<char *> bufs;
+      std::vector<uint32_t> offs;
+      reqs.reserve(cnt);
+      bufs.reserve(cnt);
+      offs.reserve(cnt);
+      for (size_t i = 0; i < cnt; i++) {
+        uint32_t id = cand[start + i].second;
+        uint32_t loc = id2loc(id);
+        uint32_t sector, off;
+        if (meta_.nnodes_per_sector > 0) {
+          sector = 1 + loc / meta_.nnodes_per_sector;
+          off = loc % meta_.nnodes_per_sector;
+        } else {
+          sector = 1 + loc * DIV_ROUND_UP(meta_.max_node_len, SECTOR_LEN);
+          off = 0;
+        }
+        char *buf = nullptr;
+        pipeann::alloc_aligned((void **) &buf, size_per_io, SECTOR_LEN);
+        bufs.push_back(buf);
+        offs.push_back(off);
+        reqs.emplace_back(sector * SECTOR_LEN, size_per_io, buf, 0, 0, buf);
+      }
+      reader->read(reqs, ctx, false);
+      for (size_t i = 0; i < cnt; i++) {
+        DiskNode<T> node = node_from_page(bufs[i], offs[i]);
+        float d = dist_cmp->compare(query, node.coords, (unsigned) aligned_dim);
+        exact.emplace_back(d, cand[start + i].second);
+      }
+      for (char *buf : bufs) pipeann::aligned_free(buf);
+    }
